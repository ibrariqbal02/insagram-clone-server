# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/speakyard

# Long random strings, different from each other (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_USER=
MAIL_PASSWORD=

# Comma-separated web origins allowed by CORS
CLIENT_URLS=http://localhost:5173,https://speakyard.vercel.app

# Cookie settings (defaults: secure=true, samesite=none for cross-domain web client)
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Max /api requests per IP per 15 minutes
RATE_LIMIT_API_MAX=3000
